{
  "name": "office-presence-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/ensure-postgres-env.mjs && prisma generate && node scripts/migrate-on-vercel.mjs && next build",
    "build:local": "prisma generate && next build",
    "typecheck": "tsc --noEmit",
    "start": "next start",
    "test": "vitest run",
    "test:bugs": "vitest run tests/bugs",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "leaflet": "^1.9.4",
    "next": "^15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "prisma": "^6.19.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
