generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum VisitSource {
  auto
  manual
  admin
  correction
}

enum EventType {
  enter
  sample
  exit
  check_in
  check_out
}

enum AlertType {
  login_otp
  hours_started
  hours_met
  points_met
  daily_summary
}

enum OfficeStatus {
  active
  pending
  rejected
  inactive
}

enum CorrectionStatus {
  pending
  approved
  rejected
  cancelled
}

enum CorrectionIssue {
  missing_visit
  wrong_times
  wrong_office
  should_not_count
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String?
  firstName               String?
  lastName                String?
  preferredName           String?
  /** first_last | preferred_last | preferred_only */
  colleagueDisplayMode    String                   @default("first_last")
  homeOfficeId            String?
  role                    Role                     @default(user)
  timezone                String                   @default("Asia/Kolkata")
  developerMode           Boolean                  @default(false)
  sharePresenceWithPeers  Boolean                  @default(false)
  sharePresenceConsentAt  DateTime?
  /** Demo / test accounts. Keep in sync with isTestAccount. */
  isDummy                 Boolean                  @default(false)
  /** Alias of isDummy for the Users admin UI. */
  isTestAccount           Boolean                  @default(false)
  deactivatedAt           DateTime?
  /** bcrypt hash; null means password sign-in is not set up yet. */
  passwordHash            String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  homeOffice              OfficeLocation?          @relation("UserHomeOffice", fields: [homeOfficeId], references: [id], onDelete: SetNull)
  otpCodes                OtpCode[]
  deviceTokens            DeviceToken[]
  events                  PresenceEvent[]
  visits                  Visit[]
  exclusions              VisitExclusion[]
  status                  CurrentStatus?
  alerts                  PendingAlert[]
  auditLogs               AuditLog[]               @relation("AuditActor")
  notificationPrefs       UserNotificationPrefs?
  officeAliases           UserOfficeAlias[]
  correctionRequests      VisitCorrectionRequest[] @relation("CorrectionRequester")
  correctionReviews       VisitCorrectionRequest[] @relation("CorrectionReviewer")
  officesCreated          OfficeLocation[]         @relation("OfficeCreator")
  officesApproved         OfficeLocation[]         @relation("OfficeApprover")
  viewAsAsAdmin           ViewAsSession[]          @relation("ViewAsAdmin")
  viewAsAsTarget          ViewAsSession[]          @relation("ViewAsTarget")
  deviceApiActivity       DeviceApiActivity[]

  @@index([homeOfficeId])
  @@index([deactivatedAt])
}

model ViewAsSession {
  id           String    @id @default(cuid())
  adminId      String
  targetUserId String
  /** readonly | full */
  mode         String
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())
  admin        User      @relation("ViewAsAdmin", fields: [adminId], references: [id], onDelete: Cascade)
  target       User      @relation("ViewAsTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([adminId, endedAt])
  @@index([targetUserId])
  @@index([expiresAt])
}

model OtpCode {
  id        String    @id @default(cuid())
  userId    String?
  email     String
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email, createdAt])
}

model DeviceToken {
  id          String             @id @default(cuid())
  userId      String
  tokenHash   String
  tokenPrefix String
  installId   String?
  label       String?
  platform    String             @default("android")
  /** Firebase Cloud Messaging registration token for remote force-logout. */
  fcmToken    String?
  lastSeenAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime           @default(now())
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      PresenceEvent[]
  apiActivity DeviceApiActivity[]

  @@index([tokenPrefix])
  @@index([userId])
}

/** Significant per-device API calls for admin Hobby diagnostics. Pruned after 14 days. */
model DeviceApiActivity {
  id            String       @id @default(cuid())
  userId        String
  deviceTokenId String?
  method        String
  path          String
  statusCode    Int
  durationMs    Int?
  note          String?
  at            DateTime     @default(now())
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken   DeviceToken? @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)

  @@index([deviceTokenId, at(sort: Desc)])
  @@index([userId, at(sort: Desc)])
}

model Policy {
  id                    Int      @id @default(1)
  gapMinutes            Int      @default(15)
  dayHours              Float    @default(5)
  monthlyDaysTarget     Int      @default(8)
  monthlyPointsTarget   Int      @default(8)
  timezone              String   @default("Asia/Kolkata")
  fenceRadiusMeters     Float    @default(100)
  sampleIntervalMinutes Int      @default(5)
  correctionWindowDays  Int      @default(5)
  updatedAt             DateTime @updatedAt
}

model OfficeLocation {
  id                String            @id @default(cuid())
  name              String
  latitude          Float
  longitude         Float
  radiusMeters      Float             @default(100)
  pointsPerVisitDay Int               @default(1)
  addressLabel      String?
  status            OfficeStatus      @default(active)
  createdByUserId   String?
  approvedByAdminId String?
  approvedAt        DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         User?             @relation("OfficeCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy        User?             @relation("OfficeApprover", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  aliases           UserOfficeAlias[]
  events            PresenceEvent[]
  statuses          CurrentStatus[]
  homeUsers         User[]            @relation("UserHomeOffice")

  @@index([status])
}

model UserOfficeAlias {
  id               String         @id @default(cuid())
  userId           String
  officeLocationId String
  displayName      String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  office           OfficeLocation @relation(fields: [officeLocationId], references: [id], onDelete: Cascade)

  @@unique([userId, officeLocationId])
}

model UserNotificationPrefs {
  userId                     String   @id
  /** Legacy: true if either enter or leave is on. Prefer notifyOfficeEnter / notifyOfficeLeave. */
  notifyOfficeDetected       Boolean  @default(true)
  notifyOfficeEnter          Boolean  @default(true)
  notifyOfficeLeave          Boolean  @default(true)
  notifyGoalMet              Boolean  @default(true)
  notifyDailySummary         Boolean  @default(true)
  notifyCorrections          Boolean  @default(true)
  notifyTrackingProblems     Boolean  @default(true)
  /** "22:00" style local time; null means quiet hours off. */
  quietHoursStart            String?
  quietHoursEnd              String?
  /** Legacy single tone; kept as fallback when a per-kind tone is unset. */
  notificationToneId         String   @default("default")
  toneEnterId                String   @default("chime")
  toneLeaveId                String   @default("soft")
  toneGoalId                 String   @default("pulse")
  toneSummaryId              String   @default("default")
  launchSoundEnabled         Boolean  @default(false)
  launchSoundId              String   @default("default")
  updatedAt                  DateTime @updatedAt
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PresenceEvent {
  id               String          @id @default(cuid())
  userId           String
  type             EventType
  recordedAt       DateTime
  latitude         Float?
  longitude        Float?
  accuracyMeters   Float?
  wifiSsid         String?
  wifiBssid        String?
  simulated        Boolean         @default(false)
  clientEventId    String?
  deviceTokenId    String?
  deviceName       String?
  officeLocationId String?
  createdAt        DateTime        @default(now())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceToken      DeviceToken?    @relation(fields: [deviceTokenId], references: [id], onDelete: SetNull)
  office           OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)

  @@unique([userId, clientEventId])
  @@index([userId, recordedAt])
}

model Visit {
  id               String          @id @default(cuid())
  userId           String
  startAt          DateTime
  endAt            DateTime?
  source           VisitSource     @default(auto)
  reason           String?
  editedBy         String?
  officeLocationId String?
  pointsAwarded    Int             @default(0)
  correctionId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@index([correctionId])
}

model VisitExclusion {
  id        String   @id @default(cuid())
  userId    String
  startAt   DateTime
  endAt     DateTime
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
}

model VisitCorrectionRequest {
  id               String           @id @default(cuid())
  userId           String
  dayKey           String
  issue            CorrectionIssue?
  proposedStart    DateTime
  proposedEnd      DateTime
  officeLocationId String?
  reason           String
  recorded         Json?
  requested        Json?
  applied          Json?
  status           CorrectionStatus @default(pending)
  reviewedById     String?
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  user             User             @relation("CorrectionRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy       User?            @relation("CorrectionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, dayKey])
}

model CurrentStatus {
  userId           String          @id
  inOffice         Boolean         @default(false)
  sinceAt          DateTime?
  hoursToday       Float           @default(0)
  pointsToday      Int             @default(0)
  monthPoints      Int             @default(0)
  monthVisitDays   Int             @default(0)
  monthDays        Int             @default(0)
  officeLocationId String?
  officeName       String?
  lastDeviceName   String?
  lastEvidenceAt   DateTime?
  updatedAt        DateTime        @updatedAt
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  office           OfficeLocation? @relation(fields: [officeLocationId], references: [id], onDelete: SetNull)
}

model PendingAlert {
  id        String    @id @default(cuid())
  userId    String
  type      AlertType
  dayKey    String
  payload   Json
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, dayKey])
  @@index([sentAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  beforeJson Json?
  afterJson  Json?
  reason     String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}
