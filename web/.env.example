DATABASE_URL="postgresql://user:pass@localhost:5432/office_presence?sslmode=require"
DIRECT_URL="postgresql://user:pass@localhost:5432/office_presence?sslmode=require"
AUTH_SECRET="replace-with-32-plus-char-secret"
ADMIN_EMAIL="soumitra.m.mandal@pwc.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Browser download URL for the signed pilot APK (prefer GitHub Release asset URL).
# Example: https://github.com/mitraxsou/office-presence/releases/download/v2.0.4-pilot/app-release.apk
# Private repo: that URL 404s for anonymous users; use a public APK host URL instead, or Firebase App Tester.
# Set the same value on Vercel (Production) and redeploy so /download can serve the button.
NEXT_PUBLIC_ANDROID_APK_URL=""
POWER_AUTOMATE_WEBHOOK_URL=""
POWER_AUTOMATE_WEBHOOK_SECRET=""
BREAKGLASS_EMAIL=""
BREAKGLASS_PASSWORD=""
# Firebase Admin SDK service account JSON as a single-line string (for FCM force-logout).
# Never commit the real key. Copy from the downloaded firebase-adminsdk*.json:
#   FIREBASE_SERVICE_ACCOUNT_JSON="$(node -e "process.stdout.write(JSON.stringify(require('./path-to-adminsdk.json')))")"
# Also set the same env on Vercel for production. Missing = push skipped; sync 401 logout still works.
# Client file: android/app/google-services.json (gitignored). Analytics is free Spark; API route logs stay in DeviceApiActivity.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Shared secret for GET|POST /api/cron/presence-ping (external hourly cron during work hours).
# Vercel Hobby cron is daily-only; use cron-job.org / GitHub Actions every 60m Mon-Fri 09-19 IST.
CRON_SECRET=""
